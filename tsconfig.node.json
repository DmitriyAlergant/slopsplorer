{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2023"
    ],
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist/node",
    "declaration": false,
    // No source maps: the published package ships `dist` without `src`, so a
    // map would point at files that are not there.
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/cli.ts",
    "src/scanner/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
