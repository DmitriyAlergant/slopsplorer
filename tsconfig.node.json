{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2023"
    ],
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist/node",
    "declaration": false,
    "sourceMap": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/cli.ts",
    "src/scanner/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
