{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/web/**/*.d.ts",
    "src/shared/**/*.ts",
    "vite.config.ts"
  ]
}
